{
    "compilerOptions": {
        "target": "es2020",
        "module": "commonjs",
        "strict": true,
        "esModuleInterop": true,
        "moduleResolution": "node",
        "skipLibCheck": true,
        "types": ["mocha", "node"]
    },
    "include": ["src/**/*.ts", "test/**/*.ts"],
    "exclude": ["src/**/*.tsx"]
}
