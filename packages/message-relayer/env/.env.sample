# Services allowed to send push. Make a row with `yarn message-relayer keys new <service-id> <app-id>`.
# Each service's key works only for its own app id. Limits are operating values, not protocol constants.
MESSAGE_RELAYER_SERVICES='[{"id":"wayhand","app":"wayhand","keyHash":"replace-with-sha256-hex-of-the-key","maxRequestsPerMinute":60,"perWalletPerDay":20}]'
# The Expo access key (Expo dashboard, with "enhanced push security" on). Only this process holds it.
EXPO_ACCESS_TOKEN=
# The SQLite file with the address-to-device table (one process owns it; back it up).
MESSAGE_RELAYER_DB=data/message-relayer.db
MESSAGE_RELAYER_HOST=127.0.0.1
MESSAGE_RELAYER_PORT=8788
# A phone with no activity (no registration, no accepted push) for this many days is deleted (default 365).
# MESSAGE_RELAYER_RETENTION_DAYS=365
# Registration and mute calls per minute from one address (default 30).
# MESSAGE_RELAYER_PUBLIC_PER_MINUTE=30
# Set to 1 only behind a proxy you control: the caller address is then read from x-forwarded-for.
# MESSAGE_RELAYER_TRUST_PROXY=1
