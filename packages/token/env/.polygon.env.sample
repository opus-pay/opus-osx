# cp env/.polygon.env.sample env/.polygon.env
# yarn token deploy:polygon 는 ENV_NETWORK=polygon 로 이 파일을 불러옵니다. 없으면 오류입니다.
# 메인넷 배분 주소는 멀티시그 또는 베스팅 컨트랙트여야 합니다.

DEPLOYER=
TREASURY=
SALE=
TEAM=
MARKETING=
LIQUIDITY=

# Ledger 주소. 값을 넣으면 개인키 대신 이 주소로 서명합니다.
# Hardhat 2 는 같은 HTTP 네트워크에 개인키와 Ledger 를 함께 둘 수 없습니다.
DEPLOYER_ADDRESS=
TREASURY_ADDRESS=
SALE_ADDRESS=
TEAM_ADDRESS=
MARKETING_ADDRESS=
LIQUIDITY_ADDRESS=

POLYGON_URL=
POLYGONSCAN_API_KEY=
# REPORT_GAS=true
