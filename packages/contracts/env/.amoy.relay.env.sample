# Zero-POL wallets for #25 and #12. Copy to env/.amoy.relay.env and fill it there.
# env/.amoy.relay.env is gitignored. Do not commit a key.
# These two keys must not be the deployer, the keeper, the relayer, or the Ledger client and provider.
# Leave both addresses at 0 POL. Send 1 Amoy USDC to the client only.

RELAY_CLIENT_PRIVATE_KEY=
RELAY_PROVIDER_PRIVATE_KEY=
# Must match the id and token in config/relayer.env.
RELAY_INTEGRATOR_ID=errands
RELAY_INTEGRATOR_TOKEN=
RELAY_URL=http://127.0.0.1:8787/relay
