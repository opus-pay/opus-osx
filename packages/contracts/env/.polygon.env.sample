# cp env/.polygon.env.sample env/.polygon.env
# yarn contracts deploy:polygon 는 ENV_NETWORK=polygon 로 이 파일을 불러옵니다. 없으면 오류입니다.
# 메인넷 TREASURY 는 멀티시그 주소여야 합니다.

DEPLOYER=
TREASURY=
OPERATOR=
ARBITRATOR=

# Ledger 주소. 값을 넣으면 개인키 대신 이 주소로 서명합니다.
# Hardhat 2 는 같은 HTTP 네트워크에 개인키와 Ledger 를 함께 둘 수 없습니다.
DEPLOYER_ADDRESS=
TREASURY_ADDRESS=
OPERATOR_ADDRESS=
ARBITRATOR_ADDRESS=

POLYGON_URL=
POLYGON_USDC=
POLYGONSCAN_API_KEY=
# REPORT_GAS=true
# 비워 두면 노드가 알려 주는 가스 가격을 씁니다. 공용 노드는 한 거래의 수수료(가스 x 가격)가 1 POL을 넘으면 거절합니다.
# 가격이 너무 높아 "tx fee exceeds the configured cap"이 나오면 200 정도로 정합니다. 거래는 가격이 내려올 때까지 대기합니다.
# POLYGON_GAS_PRICE_GWEI=
