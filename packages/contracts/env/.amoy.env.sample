# cp env/.amoy.env.sample env/.amoy.env
# yarn contracts deploy:amoy 는 ENV_NETWORK=amoy 로 이 파일을 불러옵니다. 없으면 오류입니다.
# 키 순서는 src/namedAccounts.ts 의 NAMED_ACCOUNT_KEYS 와 일치해야 합니다.

DEPLOYER=
TREASURY=
OPERATOR=
ARBITRATOR=

# Ledger 주소. 값을 넣으면 개인키 대신 이 주소로 서명합니다.
# Hardhat 2 는 같은 HTTP 네트워크에 개인키와 Ledger 를 함께 둘 수 없습니다.
# 쓰는 경우 NAMED_ACCOUNT_KEYS 전부에 대응하는 *_ADDRESS 를 모두 채우십시오.
DEPLOYER_ADDRESS=
TREASURY_ADDRESS=
OPERATOR_ADDRESS=
ARBITRATOR_ADDRESS=

AMOY_URL=
POLYGONSCAN_API_KEY=
# REPORT_GAS=true
