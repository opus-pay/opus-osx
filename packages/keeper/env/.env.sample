# Keeper hot wallet (#24). This file is an empty sample. Copy it to env/.env and fill it there.
# The real env/.env is gitignored. Do not commit a key. This wallet must not be the deployer.

KEEPER_PRIVATE_KEY=
DEPLOYER_ADDRESS=
KEEPER_ADDRESSES=packages/contracts/deploy/amoy/addresses.json
KEEPER_RPC_URL=https://polygon-amoy.drpc.org
# Alert below 0.05 POL. That covers a few calls at the 25 gwei Amoy floor.
KEEPER_LOW_BALANCE_WEI=50000000000000000
# Defaults to the contract safety margin (1 hour) when empty.
KEEPER_EXPIRY_MARGIN_SECONDS=
KEEPER_POLL_MS=30000
