# Keeper hot wallet (#24). This file is an empty sample. Copy it to env/.env and fill it there.
# The real env/.env is gitignored. Do not commit a key. This wallet must not be the deployer.

KEEPER_PRIVATE_KEY=
DEPLOYER_ADDRESS=
# Relative to packages/keeper, which is the working directory of `yarn keeper start`.
KEEPER_ADDRESSES=../contracts/deploy/amoy/addresses.json
KEEPER_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
# Alert below 0.05 POL. That covers a few calls at the 25 gwei Amoy floor.
KEEPER_LOW_BALANCE_WEI=50000000000000000
# Defaults to the contract safety margin (1 hour) when empty.
KEEPER_EXPIRY_MARGIN_SECONDS=
KEEPER_POLL_MS=30000

# Optional safety and alerts.
# POST alerts here as JSON {service, text, alert}. A Slack/Discord-style incoming webhook works. Empty: log only.
# KEEPER_ALERT_WEBHOOK_URL=
# The same alert for the same job repeats after this long (default 3600000 ms = 1 hour).
# KEEPER_ALERT_COOLDOWN_MS=3600000
# Wait for a block after sending (default 90000 ms). After that the call counts as pending.
# KEEPER_RECEIPT_TIMEOUT_MS=90000
# A pending call is not sent again for this long (default 600000 ms).
# KEEPER_PENDING_TTL_MS=600000
# Health check for an uptime monitor: GET /health on this host and port. "off" turns it off.
# KEEPER_HEALTH_HOST=127.0.0.1
# KEEPER_HEALTH_PORT=8789

# Read the live jobs from an indexer instead of every job on the chain. Falls back to a full scan when the
# indexer is down or has not caught up, and scans everything every KEEPER_FULL_SCAN_EVERY passes (default 20).
# KEEPER_INDEXER_URL=http://127.0.0.1:8788
# KEEPER_INDEXER_TOKEN=
# KEEPER_FULL_SCAN_EVERY=20
