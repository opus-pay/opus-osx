# Indexer (#26). Copy to env/.env. No private key: this process only reads logs.

# Relative to packages/indexer, which is the working directory of `yarn indexer start`.
INDEXER_ADDRESSES=../contracts/deploy/amoy/addresses.json
INDEXER_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
INDEXER_HOST=127.0.0.1
INDEXER_PORT=8788
INDEXER_POLL_MS=15000
# Factory deployment on Amoy. The indexer does not read earlier blocks.
INDEXER_FROM_BLOCK=48650402
# NOTE: after a new deployment, set this to the new factory's deployment block.

# Optional.
# Keeps the ledger and the scan position across restarts (a JSON file the process writes).
# INDEXER_STATE_FILE=env/state.json
# Stay this many blocks behind the head (default 5 on Amoy, 0 on a local node).
# INDEXER_CONFIRMATIONS=5
# If set, every path but /health needs "Authorization: Bearer <token>".
# INDEXER_API_TOKEN=
