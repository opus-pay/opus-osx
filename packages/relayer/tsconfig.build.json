{
    // Builds to dist/ without the source mapping of @opus/sdk, so the output is only this package. At run time
    // `@opus/sdk` comes from node_modules (its own built dist), which is how the Docker image resolves it.
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "rootDir": "./src",
        "baseUrl": null,
        "paths": {}
    },
    "include": ["./src"]
}
