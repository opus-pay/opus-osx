# Relayer hot wallet (#25). Copy this file to env/.env and fill it there.
# The real env/.env is gitignored. Do not commit a key. This wallet must not be the deployer.

RELAYER_PRIVATE_KEY=
DEPLOYER_ADDRESS=
# Paths are relative to packages/relayer, the working directory of `yarn relayer start`.
RELAYER_ADDRESSES=../contracts/deploy/amoy/addresses.json
RELAYER_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
# One checksummed address per line. The process refuses to start without this file.
# An empty list relays every signer; a production list is the applicable sanctions list.
RELAYER_SANCTIONS_FILE=env/sanctions.txt
RELAYER_HOST=127.0.0.1
RELAYER_PORT=8787
# Operating limits, not protocol constants. budgetWei is the gas the integrator may spend.
RELAYER_INTEGRATORS='[{"id":"errands","token":"replace-me","budgetWei":"1000000000000000000","maxRequests":60,"windowSeconds":60}]'

# An app that cannot keep a secret (a mobile wallet) uses a public integrator: no token, but per-signer limits
# are required. "signer" caps one signing address inside the window (requests and gas, in wei); budgetWei still
# caps the whole integrator, so keep it small. A person with many addresses is stopped by budgetWei, not by "signer".
# RELAYER_INTEGRATORS='[{"id":"errands","token":"replace-me","budgetWei":"1000000000000000000","maxRequests":60,"windowSeconds":60},{"id":"app","public":true,"budgetWei":"200000000000000000","maxRequests":30,"windowSeconds":60,"signer":{"maxRequests":10,"windowSeconds":86400,"gasWei":"20000000000000000"}}]'

# Safety and operations (all optional).
# The most gas one request may ask for (default 1500000).
# RELAYER_MAX_GAS=1500000
# How long to wait for a block before the answer is "pending" (default 120000 ms).
# RELAYER_RECEIPT_TIMEOUT_MS=120000
# Below this balance /health answers 503 and new requests are refused with 503, so top up before it runs dry.
# RELAYER_MIN_BALANCE_WEI=200000000000000000
# Keeps each integrator's remaining budget across restarts (a small JSON file the process writes).
# RELAYER_STATE_FILE=env/budgets.json
