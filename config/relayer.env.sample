# Daemon env for the relayer. Copy to config/relayer.env and fill the key there.
# config/relayer.env is gitignored. Do not commit a key.
# Address and sanctions paths are inside the container. compose.yaml mounts config/addresses.json and config/sanctions.txt there.

RELAYER_PRIVATE_KEY=
DEPLOYER_ADDRESS=
RELAYER_ADDRESSES=/config/addresses.json
RELAYER_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
RELAYER_SANCTIONS_FILE=/config/sanctions.txt
RELAYER_HOST=0.0.0.0
RELAYER_PORT=8787
RELAYER_INTEGRATORS='[{"id":"errands","token":"replace-me","budgetWei":"1000000000000000000","maxRequests":60,"windowSeconds":60}]'
