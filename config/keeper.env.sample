# Daemon env for the keeper. Copy to config/keeper.env and fill the key there.
# config/keeper.env is gitignored. Do not commit a key.
# KEEPER_ADDRESSES is the path inside the container. compose.yaml mounts config/addresses.json there.

KEEPER_PRIVATE_KEY=
DEPLOYER_ADDRESS=
KEEPER_ADDRESSES=/config/addresses.json
KEEPER_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
KEEPER_LOW_BALANCE_WEI=50000000000000000
KEEPER_EXPIRY_MARGIN_SECONDS=
KEEPER_POLL_MS=30000

# The health check listens inside the container; compose publishes it on 127.0.0.1:8789.
KEEPER_HEALTH_HOST=0.0.0.0
KEEPER_HEALTH_PORT=8789
# Alerts go to this webhook (Slack or Discord style) as well as the log.
# KEEPER_ALERT_WEBHOOK_URL=
# Read the live jobs from the indexer instead of every job (falls back to a scan when it is down or behind).
# KEEPER_INDEXER_URL=http://indexer:8788
# KEEPER_INDEXER_TOKEN=
