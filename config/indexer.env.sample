# Daemon env for the indexer. Copy to config/indexer.env.
# config/indexer.env is gitignored. It holds no key, but INDEXER_DATABASE_URL may hold a database password.
# INDEXER_ADDRESSES is the path inside the container. compose.yaml mounts config/addresses.json there.

INDEXER_ADDRESSES=/config/addresses.json
# Use a dedicated RPC (for example an Alchemy Amoy URL). Public endpoints limit log requests.
INDEXER_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
INDEXER_PORT=8788
INDEXER_POLL_MS=15000
# The block the factory was deployed in. Set it again after every new deployment. Required on Amoy.
INDEXER_FROM_BLOCK=
# Stay this many blocks behind the head (default 5 on Amoy).
INDEXER_CONFIRMATIONS=5
# The image keeps a SQLite ledger in the /data volume (INDEXER_DB_FILE=/data/index.db). To share one ledger between
# servers use PostgreSQL instead; it wins over the file when set.
# INDEXER_DATABASE_URL=postgres://user:password@host:5432/opus_index
# If set, every path but /health needs "Authorization: Bearer <token>".
# INDEXER_API_TOKEN=
